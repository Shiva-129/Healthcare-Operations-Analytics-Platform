# ==============================================================================
# Healthcare Operations Analytics Platform - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# --- Dataset Configuration ---
# Canonical dataset source: prasad22/healthcare-dataset
KAGGLE_DATASET=prasad22/healthcare-dataset

# Optional: Path to a local raw CSV file (bypasses Kaggle download if specified)
# LOCAL_CSV_PATH=data/raw/hospital_raw.csv

# Optional Kaggle API credentials (only needed if dataset requires authentication)
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Database Configuration ---
# DB_ENGINE: "sqlite" for local development (zero configuration needed) or "sqlserver" for production
DB_ENGINE=sqlite

# SQLite settings (used when DB_ENGINE=sqlite)
SQLITE_DB_PATH=data/cleaned/hospital.db
DB_TABLE_NAME=patients

# SQL Server settings (used when DB_ENGINE=sqlserver)
DB_SERVER=localhost
DB_NAME=HospitalDB
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- AI Data Assistant / RAG Configuration ---
# Set USE_OLLAMA=1 to use a local Ollama model, or USE_OLLAMA=0 for OpenAI
USE_OLLAMA=1
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI settings (used if USE_OLLAMA=0)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
